# ── Database ────────────────────────────────────────────────
# Local development (SQLite — no setup needed):
DATABASE_URL="file:./db/custom.db"

# Production (Vercel) — use a Postgres database (Neon / Supabase / Vercel Postgres):
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── Auth ────────────────────────────────────────────────────
# REQUIRED in production. Generate one with:  openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# ── Optional ────────────────────────────────────────────────
# NEXTAUTH_SECRET=""  # fallback if AUTH_SECRET is not set
